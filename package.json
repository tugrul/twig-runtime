{
  "name": "@tugrul/twig-runtime",
  "version": "1.0.1",
  "description": "A high-performance, stream-based runtime library for executing transpiled Twig templates in JavaScript/TypeScript.",
  "keywords": [
    "twig",
    "template"
  ],
  "author": "Tu\u011frul Topuz <tugrultopuz@gmail.com>",
  "bugs": {
    "url": "https://github.com/tugrul/twig-runtime/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tugrul/twig-runtime.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.9",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}